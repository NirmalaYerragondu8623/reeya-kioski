# Only needed if the backend isn't reachable via the /api dev proxy — i.e.
# always required in production (Vercel), since there is no dev proxy there.
# Set to the deployed backend's full URL, no trailing slash, e.g.:
#   VITE_API_BASE_URL=https://reeya-kioski-backend.onrender.com
# Leave unset for local dev to use the Vite proxy (vite.config.ts) instead.
VITE_API_BASE_URL=
