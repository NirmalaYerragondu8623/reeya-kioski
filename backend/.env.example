# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Embedding backend: Gemini Embedding 2, hosted (see app/services/embeddings.py).
# Get a key from Google AI Studio (https://aistudio.google.com/apikey).
EMBEDDING_MODEL_NAME=gemini-embedding-2-preview
GEMINI_API_KEY=your-gemini-api-key

# Presigned upload URLs
PRESIGN_EXPIRY_SECONDS=300

# Teammate's product-image API (external dependency, see scripts/index_catalog.py)
PRODUCT_API_URL=https://reeyalifestyle.com/wp-json/reeya-kiosk/v1
PRODUCT_API_KEY=your-api-key

# Voice search: filter extraction from a transcript (see app/services/extract_filters.py)
OPENAI_API_KEY=your-openai-api-key

# Comma-separated list of frontend origins allowed to call this API.
# Only matters once frontend and backend are deployed on different domains.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Additionally allow any origin matching this regex — defaults to any
# *.vercel.app subdomain, since Vercel preview deployments get a new random
# subdomain per push/PR that ALLOWED_ORIGINS could never keep up with.
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$
